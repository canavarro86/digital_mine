# Пример переменных. Реальные пароли генерирует `make up` в .secrets/ (не в git).
CLUSTER_NAME=digital-mine
HTTP_PORT=9999
API_PORT=6550
NAMESPACE=digital-mine
# Образы (до CI/CD собираются локально; после — из GHCR)
IMAGE_REGISTRY=local
IMAGE_TAG=dev
# Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
