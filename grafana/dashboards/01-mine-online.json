   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT f.name AS забой, f.kind AS вид, f.status AS статус, f.cycle_no AS цикл, to_char(f.status_since,'DD.MM HH24:MI') AS с FROM faces f ORDER BY f.kind, f.name",
