     "editorType": "sql",
     "queryType": "table",
     "format": 1,
     "rawSql": "SELECT toStartOfHour(ts) AS t, count() AS переходы FROM face_status WHERE $__timeFilter(ts) GROUP BY t ORDER BY t",
