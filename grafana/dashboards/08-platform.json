{
 "uid": "dm-platform",
 "title": "8. Платформа",
 "tags": [
  "digital-mine"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Память подов, МБ",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (namespace,pod) (container_memory_working_set_bytes{container!=\"\",namespace=~\"digital-mine|monitoring\"}) / 1048576",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decmbytes"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Процессор подов, ядра",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container!=\"\",namespace=~\"digital-mine|monitoring\"}[2m]))",
     "legendFormat": "{{pod}}"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Память стека, ГБ",
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(container_memory_working_set_bytes{container!=\"\"}) / 1073741824"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decgbytes",
     "decimals": 2
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Запросы в секунду по сервисам",
   "gridPos": {
    "x": 6,
    "y": 9,
    "w": 9,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(dm_http_requests_total[2m]))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Ошибки 5xx в секунду",
   "gridPos": {
    "x": 15,
    "y": 9,
    "w": 9,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(dm_http_errors_total[5m]))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Время ответа p95, с",
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(dm_http_request_seconds_bucket[5m])))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "HPA: копии ingest и calc",
   "gridPos": {
    "x": 12,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"digital-mine\"}",
     "legendFormat": "{{horizontalpodautoscaler}}"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Поды не Running",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 6,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(kube_pod_status_phase{phase!~\"Running|Succeeded\",namespace=~\"digital-mine|monitoring\"})"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "События в секунду (опубликовано / обработано)",
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (service, kind) (rate(dm_events_total[2m]))",
     "legendFormat": "{{service}} {{kind}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Очередь NATS (ingest) и задержка обработки, с",
   "gridPos": {
    "x": 12,
    "y": 25,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(dm_queue_pending)",
     "legendFormat": "очередь",
     "refId": "A"
    },
    {
     "expr": "max(dm_ingest_lag_seconds)",
     "legendFormat": "задержка, с",
     "refId": "B"
    }
   ]
  }
 ]
}