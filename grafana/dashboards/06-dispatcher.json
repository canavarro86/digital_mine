    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT to_char(ts,'DD.MM HH24:MI') AS время, rule AS правило, entity AS объект FROM alerts WHERE audience='dispatcher' AND status='open' ORDER BY ts DESC",
